{
  "manifest_version": 3,
  "name": "EbooksHub Assistant",
  "version": "1.0.0",
  "key": "",
  "description": "Step-by-step help getting your EbooksHub book set up and published on Amazon Kindle and other platforms. Tells you what to click and type — you stay in control.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open EbooksHub Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": [
    "https://ebookhubs.com/*",
    "http://localhost:3000/*",
    "https://*.amazon.com/*",
    "https://kdp.amazon.com/*",
    "https://*.draft2digital.com/*",
    "https://*.ingramspark.com/*"
  ],
  "externally_connectable": {
    "matches": ["https://ebookhubs.com/*", "http://localhost:3000/*"]
  }
}
