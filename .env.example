# ── App ───────────────────────────────────────────────────────────────
# Use http://localhost:3000 for local dev; set to https://ebookshub.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EbooksHub

# ── Supabase (database, auth, storage) ──────────────────────────────────
# Create a project at https://supabase.com, then run the SQL files in
# supabase/migrations against it (see README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by API routes / background
# job processing to bypass RLS for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI: text generation — 3 providers, routed by book subject ───────────
# Which provider writes a given book is decided in lib/ai/text-router.ts
# (creative/narrative -> Anthropic, structured/technical -> DeepSeek,
# everything else -> OpenAI), with automatic fallback to whichever of the
# three IS configured if the preferred one's key is missing. You don't need
# all three set — the app works with just one — but subject-based routing
# only kicks in once more than one is configured.

# Anthropic (Claude) — creative/narrative books: novels, children's books,
# fantasy, romance, mystery, sci-fi, poetry, memoir, biography. Also the
# default for the in-editor AI writing assistant regardless of book type.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Cheaper/faster model used for short, low-stakes calls. Falls back to
# ANTHROPIC_MODEL if unset.
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# DeepSeek — structured/technical books: nonfiction, educational, business,
# self-help, cookbooks, history. OpenAI-compatible API (see lib/ai/text-provider.ts).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI (GPT) — general-purpose default (travel, comics, activity/coloring
# books, custom/unclassified) and also powers the OpenAI image fallback below.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6

# ── AI: image generation — 3 providers, tried in fallback order ─────────
# Gemini -> Higgsfield -> OpenAI. Each is tried in turn on failure; only
# the providers with keys set are attempted. See lib/ai/image-provider.ts.

# Gemini (Nano Banana 2 / gemini-3.1-flash-image) — 1st choice for covers/illustrations.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Higgsfield (Soul standard model) — 2nd choice. Issued as a paired id+secret.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_RESOLUTION=2K

# OpenAI gpt-image-1 — 3rd choice / final fallback (uses OPENAI_API_KEY above).
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Background job processing ────────────────────────────────────────────
# Shared secret required in the `x-ebookshub-worker-secret` header when
# calling /api/jobs/process. Set this to a long random string and use the
# same value in whatever calls the endpoint on a schedule (see README.md
# for the "no external queue" cron-based setup, or swap in BullMQ/Redis
# later using the same job/task tables).
JOB_WORKER_SECRET=

# ── Payments (Stripe) — wired in a later phase, safe to leave blank for now
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
